{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    //"moduleResolution": "node",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": false,
    "sourceMap": true,
    "types": ["node"],
    "verbatimModuleSyntax": false
  },
  "include": [
    "server.ts",
    "api/**/*.ts",
    "src/**/*.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "ts-node": {
    "files": true
  }
}